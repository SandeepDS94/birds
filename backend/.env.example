# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to backend/.env and fill in your actual credentials.
# ==============================================================================

# Supabase API & Project Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret for token verification
# Obtain from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Storage Bucket name (created via database/03_storage.sql)
SUPABASE_STORAGE_BUCKET=bird-audio

# BirdNET Inference Configuration
# Minimum confidence (0.0 to 1.0) required to claim confident identification
BIRD_CONFIDENCE_THRESHOLD=0.50

# Audio Upload Restrictions
MAX_UPLOAD_MB=25

FRONTEND_ORIGIN=http://localhost:5173

# Gemini API Configuration for Image Generation
GEMINI_API_KEY=your-gemini-api-key-here
